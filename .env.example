# Copy to .env for local development. Never commit .env or live keys.
# Add these values through your hosting provider's secret/environment settings.

# Use a Stripe test secret key until an end-to-end test checkout passes.
STRIPE_SECRET_KEY=

# Existing Stripe Shipping Rate ID (shr_...). Configure rates in Stripe first.
STRIPE_SHIPPING_RATE_ID=

# ISO two-letter country codes for destinations you support.
SHIPPING_COUNTRIES=US

# Optional exact public storefront origin, without trailing slash.
PUBLIC_ORIGIN=

# Optional customer support email displayed by the storefront.
SUPPORT_EMAIL=

# Enable only after configuring Stripe Tax and tax registrations.
STRIPE_AUTOMATIC_TAX=false

# Optional local preview port.
PORT=3000
